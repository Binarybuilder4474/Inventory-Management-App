<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="650" prefWidth="1000" style="-fx-background-color: #161616;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ia999.ProductControllerSale">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>


        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>


                <TextField fx:id="Serach" prefHeight="30.0" prefWidth="626.0" promptText="Search Product..." style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #bbbbbb;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>


                <TableView fx:id="saleTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="saleNameColumn" prefWidth="150" text="Product Name" />
                        <TableColumn fx:id="saleNumberColumn" prefWidth="150" text="Product Number" />
                        <TableColumn fx:id="salePriceColumn" prefWidth="100" text="Selling Price" />
                        <TableColumn fx:id="saleQuantityColumn" prefWidth="100" text="Quantity Sold" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>


        <VBox alignment="TOP_CENTER" prefHeight="544.0" prefWidth="220.0" spacing="25.0" style="-fx-background-color: #282828; -fx-background-radius: 10;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <HBox.margin>
                <Insets left="20.0" />
            </HBox.margin>
            <children>


                <HBox alignment="TOP_RIGHT" prefHeight="25.0" prefWidth="60.0">
                    <Button fx:id="backsales" onAction="#backsales" prefHeight="18.0" prefWidth="70.0" style="-fx-background-color: #FFDE21; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Back">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Button>
                </HBox>


                <Label prefHeight="53.0" prefWidth="202.0" text="Finance" textFill="#ffde21">
                    <font>
                        <Font name="System Bold" size="40.0" />
                    </font>
                </Label>


                <Label alignment="CENTER" prefHeight="29.0" prefWidth="180.0" text="Sales Entry" textFill="#ffde21">
                    <font>
                        <Font name="System Bold" size="27.0" />
                    </font>
                </Label>


                <TextField fx:id="saleNameField" promptText="Product Name" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #bbbbbb;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>

                <TextField fx:id="saleNumberField" promptText="Product Number" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #bbbbbb;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>

                <TextField fx:id="salePriceField" promptText="Selling Price" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #bbbbbb;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>

                <TextField fx:id="saleQuantityField" promptText="Quantity Sold" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #bbbbbb;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>


                <Button fx:id="updateSaleButton" onAction="#onUpdateSale" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #FFDE21; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Update">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>


                <Button fx:id="ClearSoldButton" layoutX="60.0" layoutY="327.0" onAction="#ClearSoldButton" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #FF3131; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Clear Quantity Sold">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                </Button>

            </children>
        </VBox>

    </children>
</HBox>
