<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom, #2b2b2b, #000000);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ia999.Items_Out_Stock">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>


    <HBox alignment="CENTER_LEFT" spacing="240.0">
        <VBox.margin><Insets bottom="20.0" /></VBox.margin>
        <Button onAction="#goBack" prefHeight="38.0" prefWidth="80.0" style="-fx-background-color: #facc15; -fx-text-fill: #161616; -fx-background-radius: 12; -fx-font-size: 14px; -fx-font-weight: bold;" text="Back" />
        <Label text="Items Out of Stock" textFill="#ff5454">
            <font><Font name="System Bold" size="32.0" /></font>
        </Label>
    </HBox>


    <HBox alignment="CENTER_LEFT" prefHeight="54.0" prefWidth="940.0" spacing="0" style="-fx-background-color: #222222; -fx-background-radius: 8; -fx-padding: 12 15 12 15; -fx-border-color: #facc15; -fx-border-width: 0 0 2 0; -fx-border-radius: 8;">
        <VBox.margin><Insets bottom="8.0" /></VBox.margin>
        <Label prefWidth="280.0" text="Product Name" textFill="#facc15">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <Label prefWidth="200.0" text="Product Number" textFill="#facc15">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <Label prefWidth="130.0" text="Quantity" textFill="#facc15">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <Label prefWidth="130.0" text="Table" textFill="#facc15">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
    </HBox>


    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="itemsContainer" spacing="8.0" style="-fx-background-color: transparent;">
            <padding><Insets top="5.0" /></padding>
        </VBox>
    </ScrollPane>

</VBox>
