<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700" prefWidth="1200" style="-fx-background-color: linear-gradient(to bottom, #2b2b2b, #000000); -fx-border-radius: 12; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ia999.Afterlogin">

   <left>
      <VBox alignment="TOP_CENTER" prefWidth="250" spacing="35.0" style="-fx-background-color: #222222; -fx-padding: 25; -fx-border-color: #facc15; -fx-border-width: 0 1 0 0;">
         <Label text="My Dashboard" textFill="#facc15">
            <font>
               <Font size="26.0" />
            </font>
         </Label>

         <Button onAction="#List" prefHeight="50" prefWidth="200" style="-fx-background-color: #facc15; -fx-text-fill: black; -fx-background-radius: 6; -fx-font-size: 16px;" text=" To-do list" />
         <Button fx:id="InteriorButton" onAction="#Inventory_1" prefHeight="50" prefWidth="200" style="-fx-background-color: #333333; -fx-text-fill: #facc15; -fx-background-radius: 6; -fx-font-size: 16px;" text="Inventory (Interior)" />
         <Button fx:id="Exterior" onAction="#Inventory_2" prefHeight="50" prefWidth="200" style="-fx-background-color: #333333; -fx-text-fill: #facc15; -fx-background-radius: 6; -fx-font-size: 16px;" text="Inventory (Exterior)" />
         <Button fx:id="Finance" layoutX="35.0" layoutY="233.0" onAction="#Finance" prefHeight="50" prefWidth="200" style="-fx-background-color: #333333; -fx-text-fill: #facc15; -fx-background-radius: 6; -fx-font-size: 16px;" text="Finance" />

         <Button fx:id="logoutButton" onAction="#userlogout" prefHeight="50" prefWidth="200" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 16px;" text="Logout" />
      </VBox>
   </left>

   <center>
      <VBox spacing="30" style="-fx-padding: 25;">
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Inventory Dashboard" textFill="#facc15">
               <font>
                  <Font size="36.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
         </HBox>
         <HBox spacing="30">
            <VBox alignment="CENTER" prefHeight="200" prefWidth="300" spacing="15" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #facc15; -fx-border-width: 1;">
               <Label text="Items in Stock" textFill="#94b6ee">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="TotalStockItems" textFill="#00ff1e">
                  <font>
                     <Font size="36.0" />
                  </font>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </Label>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200" prefWidth="300" spacing="15" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #facc15; -fx-border-width: 1;">
               <Label text="Items Low in Stock" textFill="#facc15">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="LowStockItems" textFill="#ff5454">
                  <font>
                     <Font size="36.0" />
                  </font>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </Label>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200" prefWidth="300" spacing="15" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #facc15; -fx-border-width: 1;">
               <Label text="Items Out of Stock" textFill="#94bdff">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="OutStockItems" textFill="RED">
                  <font>
                     <Font size="36.0" />
                  </font>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </Label>
            </VBox>
         </HBox>
         <HBox spacing="30">
            <VBox alignment="CENTER" prefHeight="200" prefWidth="300" spacing="15" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #facc15; -fx-border-width: 1;">
               <Label text="Investment" textFill="#38bdf8">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="investmentLabel" textFill="#38bdf8">
                  <font>
                     <Font size="30.0" />
                  </font>
               </Label>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200" prefWidth="300" spacing="15" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #facc15; -fx-border-width: 1;">
               <Label text="Profit/loss" textFill="#28f5b1">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="profitLabel" textFill="#10b981">
                  <font>
                     <Font size="30.0" />
                  </font>
               </Label>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200" prefWidth="300" spacing="15" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #facc15; -fx-border-width: 1;">
               <Label text="Revenue" textFill="#f97316">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="profitMarginLabel" textFill="#f97316">
                  <font>
                     <Font size="30.0" />
                  </font>
               </Label>
            </VBox>
         </HBox>
         <VBox alignment="CENTER" prefHeight="299.0" prefWidth="900.0" spacing="12" style="-fx-background-color: #1a1a1a; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #333333;">
            <Label text="💡 Tip of the Day" textFill="#facc15">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label text="Check low stock items early each day to avoid delays in supply." textFill="#cccccc" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </VBox>
      </VBox>
   </center>
</BorderPane>
