<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="650" prefWidth="1000" style="-fx-background-color: #161616;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ia999.ProductController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <TextField fx:id="searchBar" promptText="Search..." style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #BBBBBB;" HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>
                        <Button fx:id="refreshButton" onAction="#onRefresh" style="-fx-background-color: #FFDE21; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Refresh">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                        <TableColumn fx:id="nameColumn" prefWidth="120" text="Product Name" />
                        <TableColumn fx:id="numberColumn" prefWidth="120" text="Product Number" />
                        <TableColumn fx:id="contactColumn" prefWidth="120" text="Supplier Contact" />
                        <TableColumn fx:id="initialPriceColumn" prefWidth="100" text="Initial Price" />
                        <TableColumn fx:id="quantityColumn" prefWidth="100" text="Quantity" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="15.0" style="-fx-background-color: #282828; -fx-background-radius: 10;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <HBox.margin>
                <Insets left="20.0" />
            </HBox.margin>
            <children>

                <HBox alignment="TOP_RIGHT" spacing="10.0">
                    <children>
                        <VBox spacing="-5.0">
                            <children>
                                <Label text="Interior" textFill="#FFDE21">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                                <Label text="Parts" textFill="#FFDE21">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#Back1" prefHeight="25.0" prefWidth="60.0" style="-fx-background-color: #FFDE21; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Back">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </HBox>

                <Label prefHeight="40.0" prefWidth="186.0" text="Product Details" textFill="#ffde21">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <TextField fx:id="idField" promptText="ID" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #BBBBBB;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="nameField" promptText="Product Name" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #BBBBBB;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="numberField" promptText="Product Number" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #BBBBBB;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="contactField" promptText="Supplier Contact" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #BBBBBB;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="initialPriceField" promptText="Initial Price" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #BBBBBB;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>
                <TextField fx:id="quantityField" promptText="Quantity" style="-fx-background-radius: 5; -fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #BBBBBB;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="addButton" onAction="#onAdd" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #FFDE21; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Add">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="updateButton" onAction="#onUpdate" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #FFDE21; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Update">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="deleteButton" onAction="#onDelete" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #FFDE21; -fx-text-fill: #161616; -fx-background-radius: 5;" text="Delete">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
