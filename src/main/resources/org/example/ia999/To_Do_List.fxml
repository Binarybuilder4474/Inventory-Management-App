<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom, #2b2b2b, #000000);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ia999.To_Do_List">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>


    <HBox alignment="CENTER_LEFT" spacing="300.0">
        <VBox.margin><Insets bottom="18.0" /></VBox.margin>
        <Button onAction="#goBack" prefHeight="38.0" prefWidth="80.0" style="-fx-background-color: #facc15; -fx-text-fill: #161616; -fx-background-radius: 12; -fx-font-size: 14px; -fx-font-weight: bold;" text="Back" />
        <Label text="To-Do List" textFill="#facc15">
            <font><Font name="System Bold" size="32.0" /></font>
        </Label>
    </HBox>


    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox.margin><Insets bottom="10.0" /></VBox.margin>
        <TextField fx:id="Idbar" prefHeight="36.0" prefWidth="60.0" promptText="ID" style="-fx-background-color: #333333; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #888888; -fx-background-radius: 6; -fx-font-size: 14px;" />
        <TextField fx:id="Taskbar" prefHeight="36.0" prefWidth="480.0" promptText="Enter task..." style="-fx-background-color: #333333; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #888888; -fx-background-radius: 6; -fx-font-size: 14px;" />
        <DatePicker fx:id="datePicker" prefHeight="36.0" prefWidth="170.0" promptText="Pick a date" style="-fx-background-color: #333333; -fx-background-radius: 6;" />
    </HBox>


    <HBox alignment="CENTER_LEFT" prefHeight="36.0" prefWidth="899.0" spacing="60.0">
        <VBox.margin><Insets bottom="15.0" /></VBox.margin>
        <Button fx:id="Addbutton" onAction="#OnAdd" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #facc15; -fx-text-fill: #161616; -fx-background-radius: 6; -fx-font-size: 14px; -fx-font-weight: bold;" text="Add" />
        <Button fx:id="Updatebutton" onAction="#OnUpdate" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #facc15; -fx-text-fill: #161616; -fx-background-radius: 6; -fx-font-size: 14px; -fx-font-weight: bold;" text="Update" />
        <Button fx:id="Deletebutton" onAction="#OnDelete" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #facc15; -fx-text-fill: #161616; -fx-background-radius: 6; -fx-font-size: 14px; -fx-font-weight: bold;" text="Delete" />
        <Button onAction="#OnClearAll" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #dc2626; -fx-text-fill: #ffffff; -fx-background-radius: 6; -fx-font-size: 14px; -fx-font-weight: bold;" text="Clear All" />
    </HBox>


    <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #222222; -fx-background-radius: 8; -fx-padding: 10 15 10 15; -fx-border-color: #facc15; -fx-border-width: 0 0 2 0;">
        <VBox.margin><Insets bottom="6.0" /></VBox.margin>
        <Label prefWidth="55.0" text="ID" textFill="#facc15">
            <font><Font name="System Bold" size="15.0" /></font>
        </Label>
        <Label prefWidth="315.0" text="Task" textFill="#facc15">
            <font><Font name="System Bold" size="15.0" /></font>
        </Label>
    </HBox>


    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <VBox fx:id="Vvbox" spacing="6.0" style="-fx-background-color: transparent;">
            <padding><Insets bottom="5.0" top="5.0" /></padding>
        </VBox>
    </ScrollPane>

</VBox>
